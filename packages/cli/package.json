{
  "name": "@codememento/cli",
  "version": "0.2.1",
  "description": "Durable repository memory for AI coding agents.",
  "keywords": [
    "ai",
    "agents",
    "documentation",
    "docs-as-code",
    "codex",
    "claude",
    "copilot",
    "cli"
  ],
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zxkws/codememento.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/zxkws/codememento#readme",
  "bugs": {
    "url": "https://github.com/zxkws/codememento/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "docs": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/cli.ts --format esm --sourcemap --clean",
    "dev": "tsx src/cli.ts",
    "test": "vitest run --passWithNoTests",
    "typecheck": "pnpm --filter @codememento/core build && tsc -p tsconfig.json --noEmit",
    "smoke": "node dist/cli.js --version && node dist/cli.js --help >/dev/null",
    "clean": "rm -rf dist coverage"
  },
  "dependencies": {
    "@codememento/core": "workspace:*",
    "commander": "^14.0.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "publishConfig": {
    "access": "public"
  }
}
