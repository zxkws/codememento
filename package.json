{
  "name": "agentdocs",
  "version": "0.0.0",
  "private": true,
  "description": "AI-native repository documentation infrastructure.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zxkws/agentdocs.git"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @agentdocs/cli dev",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "clean": "pnpm -r clean"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "eslint": "^9.35.0",
    "typescript-eslint": "^8.42.0"
  }
}
